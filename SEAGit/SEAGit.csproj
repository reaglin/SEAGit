<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>icons\seagit.ico</ApplicationIcon>
    <!-- Per-monitor DPI awareness is declared in app.manifest; without referencing
         it here the process falls back to system-DPI scaling and renders blurry/
         mis-sized on high-DPI displays like the Store cert lab's Surface Laptop. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Enables restore/publish for the win-x64 self-contained MSIX build.
         Does not change the default framework-dependent build. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="icons\seagit.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- MinGit (Git for Windows redistributable) is bundled so SEAGit ships
         with Git and does not direct users to a third-party download — Store
         policy 10.1.5. The full tree is copied next to the executable; the
         launcher at MinGit\cmd\git.exe sets up the environment for mingw64. -->
    <Content Include="MinGit\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="seagit.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>