<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows version (10.0.19041) gives the program the Windows Store API
         (Windows.Services.Store) that Help > Check for a new version uses
         (2026-10-30). It stays on .NET 8. SupportedOSPlatformVersion keeps the
         lowest Windows it runs on matching MinVersion in Package.appxmanifest.
         The build folder is now bin\<config>\net8.0-windows10.0.19041.0. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>icons\seagit.ico</ApplicationIcon>
    <!-- Per-monitor DPI awareness is declared in app.manifest; without referencing
         it here the process falls back to system-DPI scaling and renders blurry/
         mis-sized on high-DPI displays like the Store cert lab's Surface Laptop. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Enables restore/publish for the win-x64 self-contained MSIX build.
         Does not change the default framework-dependent build. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Shown in Help > About. Keep it matching the Store package version in
         WapProjTemplate/Package.appxmanifest (1.0.6.0). -->
    <Version>1.0.6</Version>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="icons\seagit.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- MinGit (Git for Windows redistributable) is bundled so SEAGit ships
         with Git and does not direct users to a third-party download — Store
         policy 10.1.5. The full tree is copied next to the executable; the
         launcher at MinGit\cmd\git.exe sets up the environment for mingw64. -->
    <Content Include="MinGit\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Images\dr-ron-eaglin.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="seagit.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>